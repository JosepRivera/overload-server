{
	"name": "overload-server",
	"version": "0.0.1",
	"author": "JosepRivera",
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=26.0.0 <27"
	},
	"scripts": {
		"build": "nest build",
		"lint": "biome check --write ./src ./test ./prisma",
		"dev": "pnpm install && docker compose up --build",
		"dev:stop": "docker compose down",
		"dev:clean": "docker compose down -v",
		"db:seed": "docker exec overload-app-dev pnpm prisma db seed",
		"db:reset": "docker exec -it overload-app-dev sh -c 'pnpm prisma migrate reset && pnpm prisma db seed'",
		"db:migrate": "docker exec -it overload-app-dev pnpm prisma migrate dev --name",
		"test": "vitest run --project unit",
		"test:e2e": "docker compose -f compose.test.yaml up --build --abort-on-container-exit --exit-code-from app-test --remove-orphans",
		"test:e2e:down": "docker compose -f compose.test.yaml down -v"
	},
	"dependencies": {
		"@nestjs/common": "^12.5.0",
		"@nestjs/core": "^12.5.0",
		"@nestjs/platform-express": "^12.5.0",
		"@nestjs/swagger": "^12.1.2",
		"@nestjs/throttler": "^6.8.0",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@scalar/nestjs-api-reference": "^1.2.38",
		"bcrypt": "^6.0.0",
		"dotenv": "^18.0.10",
		"jose": "^6.2.17",
		"nestjs-zod": "^5.6.0",
		"prisma": "^7.10.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@nestjs/cli": "^12.0.13",
		"@nestjs/schematics": "^12.0.13",
		"@nestjs/testing": "^12.5.0",
		"@swc/cli": "^0.8.2",
		"@swc/core": "^1.16.22",
		"@swc/helpers": "^0.5.24",
		"@types/bcrypt": "^6.0.0",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.6",
		"@types/supertest": "^7.2.1",
		"supertest": "^7.3.2",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0"
	}
}
